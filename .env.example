# Google Maps JavaScript API key used by the /restaurants map.
# Create one at https://console.cloud.google.com/google/maps-apis/credentials and
# restrict it to the "Maps JavaScript API" plus your site's HTTP referrers.
PUBLIC_GOOGLE_MAPS_API_KEY=

# Map ID, required for advanced markers. Create one under
# https://console.cloud.google.com/google/maps-apis/studio/maps
# DEMO_MAP_ID works while developing, but is not meant for production.
PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
